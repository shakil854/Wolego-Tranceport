# ==============================================
# Wolego Transport Backend Environment Config
# ==============================================

# Server Port
PORT=8002

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=wolego_user
DB_PASSWORD=your_secure_password
DB_NAME=wolego_db
DB_PORT=3306

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_TOKEN_EXPIRESIN=1d

# Express Session Secret
SESSION_SECRET=your_session_secret_key_here

# (Optional) Puppeteer Custom Executable Path on Linux VPS if using system Chromium
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
